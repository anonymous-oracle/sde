    "def gradient_descent_step(x, slope, learning_rate=0.1):\n",
    "    return x - learning_rate * slope\n",
    "x=3\n",
    "slope = 2 * x\n",
    "learning_rate = 1\n",
    "for i in range(20):\n",
    "    x=gradient_descent_step(x, slope, learning_rate)\n",
    "    slope = 2 * x\n",
    "    print(x)"
